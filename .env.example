# browser-ptt 環境變數範本
# 複製成 .env(放專案根目錄)填入你的值,然後直接 `npm start` 即可 —
# 伺服器會自動讀取這個 .env(任何 Node ≥ 18,不需要額外旗標)。
# .env 已被 git 忽略,不會上傳;請勿把金鑰 commit。

# 伺服器埠(預設 3000)
PORT=3000

# JWT 簽章密鑰(正式環境務必改成隨機長字串)
JWT_SECRET=change-me-to-a-long-random-string

# --- TURN(跨 NAT 通話必備)-------------------------------------------------
# 兩種方式擇一。

# 方式 1(推薦,供應商給 API Key / 動態帳密,如 metered.live):
# 伺服器會在登入時自動去這個網址抓「最新」的 TURN 帳密,不會過期。
# TURN_CREDENTIALS_URL=https://YOUR_APP.metered.live/api/v1/turn/credentials?apiKey=YOUR_API_KEY

# 方式 2(靜態帳密,如自架 coturn):
# TURN_URL 可用逗號放多個傳輸埠(udp / tcp / tls-443)。
# TURN_URL=turn:YOUR_HOST:80,turn:YOUR_HOST:80?transport=tcp,turns:YOUR_HOST:443?transport=tcp
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-credential

# --- STUN(選填,預設 Google STUN)-----------------------------------------
# STUN_URL=stun:stun.l.google.com:19302

# --- Supabase 診斷資料庫 ---------------------------------------------------
# 只放在伺服器環境；SUPABASE_SECRET_KEY 絕對不可放到 public/ 或 GitHub。
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key
# 舊專案也支援 legacy service_role：
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# 診斷事件保留天數（預設 30）
DIAGNOSTIC_RETENTION_DAYS=30

# --- MCP -------------------------------------------------------------------
# MCP 客戶端連到 Skybridge /mcp 時使用的 Bearer token。
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# MCP 呼叫 PTT 管理端點時使用；PTT 與 MCP 兩邊必須相同。
PTT_MCP_SHARED_SECRET=replace-with-another-long-random-token

# MCP 服務呼叫 PTT 後端的位置（本機預設 http://localhost:3000）。
PTT_ADMIN_URL=http://localhost:3000

# MCP 開發服務埠（預設 3100）
MCP_PORT=3100
